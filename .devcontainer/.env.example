# Copy this file to .env (same folder) and fill it in. .env is gitignored.
# The dev container won't start until .env exists.

# Your foundryvtt.com account. Used on first start to download Foundry and
# fetch your license. After the first download, the zip is cached in the
# Foundry data volume.
FOUNDRY_USERNAME=
FOUNDRY_PASSWORD=

# Password for Foundry's Setup screen (http://localhost:30000).
# Pick anything; it only protects this local dev server.
FOUNDRY_ADMIN_KEY=

# Optional: set your license key directly instead of fetching it with your account.
# FOUNDRY_LICENSE_KEY=
